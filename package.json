{
  "name": "wf-minimal-code-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "VITE_TUNNEL_HMR=1 vite",
    "deploy": "bun run build:pages && vercel --prod",
    "build:pages": "tsc && bun run scripts/build.ts",
    "build:dev": "tsc && vite build",
    "preview:pages": "bun run build:pages && bunx serve dist -p 4173",
    "staging": "bun run scripts/build.ts --watch",
    "preview": "vite preview",
    "lint": "oxlint --fix src",
    "format": "oxfmt --write src"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.3",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.23",
    "tempus": "^1.0.0-dev.17"
  }
}
