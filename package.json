{
  "name": "wf-minimal-code-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "VITE_TUNNEL_HMR=1 vite",
    "deploy": "bun run build:pages && vercel --prod",
    "build:pages": "tsc && bun run scripts/build.ts",
    "build:dev": "tsc && vite build",
    "preview:pages": "bun run build:pages && bunx serve dist -p 4173",
    "staging": "bun run scripts/build.ts --watch",
    "preview": "vite preview",
    "lint": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.1",
    "vite-plugin-eslint": "^1.8.1"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.23",
    "tempus": "^1.0.0-dev.17"
  }
}
